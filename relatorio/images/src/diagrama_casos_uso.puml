@startuml diagrama_casos_uso
!include estilo-vp.iuml
skinparam linetype polyline
' Diagrama de casos de uso atualizado (Fase 1 — vídeo): o diagrama de base com os casos de uso
' de vídeo acrescentados (a laranja: novos ou alterados).
' Gerar (na pasta relatorio): docker run --rm -v "$PWD":/w -v "$PWD/fonts":/usr/share/fonts/carlito:ro -w /w plantuml/plantuml:1.2024.7 -tpng -Sdpi=200 images/src/*.puml -o ..
left to right direction

actor "Anónimo" as Anon
actor "Utilizador" as User
actor "Premium" as Prem
actor "Utilizador Convidado" as Conv

Anon -|> User
Prem -|> User
Conv -|> User

rectangle "Sistema" {
  usecase "Registo" as Reg
  usecase "Login" as Login
  usecase "Carregar imagens\ne vídeos" as Up <<novo>>
  usecase "Aplicar encadeamento\nde ferramentas" as Apl
  usecase "Criar filtro personalizado" as Filtro
  usecase "Partilhar projeto" as Part
  usecase "Assistente IA na edição" as IA
  usecase "Cortar vídeo" as V2 <<novo>>
  usecase "Gerar legendas" as V1 <<novo>>
  usecase "Extrair frames" as V3 <<novo>>
  usecase "Desfocar caras" as V4 <<novo>>
  usecase "Converter ou\ncomprimir vídeo" as V5 <<novo>>
}

Anon -- Reg
User -- Login
User -- Up
User -- Apl
User -- Filtro
User -- Part
User -- V2
User -- V1
User -- V3
User -- V4
User -- V5
Prem -- IA
@enduml
