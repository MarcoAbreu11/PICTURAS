' Estilo comum aos diagramas, igual ao dos diagramas de base (Visual Paradigm):
' elementos azuis, traço preto fino, linhas retas e ortogonais, cantos vivos.
' Elementos novos ou alterados pela Fase 1 usam o estereótipo <<novo>> (laranja).
skinparam linetype ortho
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultFontName Carlito
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #000000
skinparam ArrowThickness 1
skinparam BackgroundColor<<novo>> #FBE3CC
hide stereotype
skinparam note {
  BackgroundColor #7ACFF5
  BorderColor #000000
}
skinparam rectangle {
  BorderColor #000000
}
skinparam package {
  BorderColor #000000
  BackgroundColor #FFFFFF
}
skinparam actor {
  BorderColor #000000
  BackgroundColor #7ACFF5
}
skinparam usecase {
  BorderColor #000000
  BackgroundColor #7ACFF5
  BackgroundColor<<novo>> #FBE3CC
}
skinparam class {
  BorderColor #000000
  BackgroundColor #7ACFF5
  BackgroundColor<<novo>> #FBE3CC
  FontStyle bold
}
skinparam component {
  BorderColor #000000
  BackgroundColor #7ACFF5
  BackgroundColor<<novo>> #FBE3CC
}
skinparam database {
  BorderColor #000000
  BackgroundColor #7ACFF5
}
skinparam queue {
  BorderColor #000000
  BackgroundColor #7ACFF5
}
skinparam sequence {
  LifeLineBorderColor #000000
  ParticipantBorderColor #000000
  ParticipantBackgroundColor #7ACFF5
  ActorBorderColor #000000
  ActorBackgroundColor #7ACFF5
  GroupBorderColor #000000
  GroupBackgroundColor #FFFFFF
}
