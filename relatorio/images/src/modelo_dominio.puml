@startuml modelo_dominio
' Modelo de domínio atualizado (Fase 1 — vídeo). Conceitos do problema, não classes de implementação.
skinparam shadowing false
skinparam defaultFontName Carlito
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #424242
  BackgroundColor<<novo>> #FBE3CC
  BorderColor<<novo>> #C76C1B
  BackgroundColor<<alterado>> #FFF4E5
  BorderColor<<alterado>> #C76C1B
  BackgroundColor<<base>> #EEEEEE
  BorderColor<<base>> #9E9E9E
  FontColor<<base>> #616161
}
hide circle
hide methods
hide stereotype

abstract class Utilizador <<alterado>>
class "Anónimo" as Anonimo <<base>>
class "Registado" as Registado <<base>>
class "Premium" as Premium <<base>>
Utilizador <|-- Anonimo
Utilizador <|-- Registado
Utilizador <|-- Premium

class "Limites de Vídeo do Perfil" as Limites <<novo>> {
  tamanho máximo
  duração máxima
  resolução máxima de saída
}
class "Quota Diária" as Quota <<alterado>> {
  operações disponíveis
}
Utilizador "*" -- "1" Limites : sujeito a >
Registado "1" -- "1" Quota : tem >

class Projeto <<alterado>>
Utilizador "1" -- "*" Projeto : é dono de >
Utilizador "*" -- "*" Projeto : acede por partilha\n(leitura | edição) >

abstract class "Item de Média" as Item <<novo>> {
  nome
  formato
  tamanho
}
class Imagem <<alterado>> {
  resolução
}
class "Vídeo" as Video <<novo>> {
  duração
  resolução
  codec de vídeo
  codec de áudio
}
Item <|-- Imagem
Item <|-- Video
Projeto "1" *-- "*" Item : biblioteca >
Video "0..1" -- "*" Video : convertido a partir de <

class "Faixa de Legendas" as Faixa <<novo>> {
  idioma: original ou inglês
  idioma detetado
}
Video "1" *-- "0..2" Faixa : tem >

abstract class Ferramenta <<alterado>> {
  parâmetros
}
class "Ferramenta Básica" as Basica <<base>>
class "Ferramenta Avançada" as Avancada <<alterado>> {
  consome 1 operação por item
}
Ferramenta <|-- Basica
Ferramenta <|-- Avancada
class "Tipo de Média" as TipoMedia <<novo>>
note right of TipoMedia : Imagem | Vídeo
Ferramenta "*" -- "1..2" TipoMedia : aceita >

class "Cortar Vídeo" as Corte <<novo>>
class "Extrair Frames" as Frames <<novo>>
class "Desfocar Caras" as Desfocar <<novo>>
class "Converter / Comprimir" as Converter <<novo>>
class "Gerar Legendas" as Legendas <<novo>>
Basica <|-- Corte
Avancada <|-- Frames
Avancada <|-- Desfocar
Avancada <|-- Converter
Avancada <|-- Legendas

Projeto "1" -- "*" Ferramenta : pipeline (ordenada) >

class "Trabalho de Processamento" as Trabalho <<novo>> {
  estado
  progresso em percentagem
  causa da falha
}
note right of Trabalho
  estado: em fila | em curso |
  concluído | falhado | cancelado
end note
Projeto "1" -- "*" Trabalho : ao Aplicar, um por item compatível >
Trabalho "*" -- "1" Item : processa >

class Resultado <<alterado>>
class "Resultado Imagem" as ResImg <<alterado>>
class "Resultado Vídeo" as ResVid <<novo>>
Resultado <|-- ResImg
Resultado <|-- ResVid
Trabalho "1" -- "0..*" Resultado : produz >
Trabalho "1" -- "0..1" Faixa : produz >

class Preset <<base>>
class "Sugestão IA" as Sugestao <<base>>
Utilizador "1" -- "*" Preset : cria >
Projeto "1" -- "*" Sugestao : recebe >
@enduml
