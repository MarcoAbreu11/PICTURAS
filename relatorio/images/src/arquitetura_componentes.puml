@startuml arquitetura_componentes
!include estilo-vp.iuml
' Vista de componentes com suporte a vídeo (a laranja: componentes novos ou alterados).

actor Browser
component nginx <<novo>>

package "UI e gateways" {
  component frontend <<novo>>
  component api_gateway <<novo>>
  component ws_gateway <<novo>>
}

package "Serviços" {
  component projects <<novo>>
  component users
  component img_storage <<novo>>
}

queue RabbitMQ <<novo>>
database projects_mongoDB
database SeaweedFS

package "Workers" {
  component "ferramentas de imagem" as wi
  component "ferramentas de vídeo\n(trim, extract_frames, blur_faces,\nvideo_convert, video_subtitles)" as wv <<novo>>
}

Browser --> nginx
nginx --> frontend
nginx --> api_gateway
nginx --> ws_gateway
api_gateway --> projects
api_gateway --> users
projects --> users
projects --> img_storage
projects --> projects_mongoDB
img_storage --> SeaweedFS
projects --> RabbitMQ
RabbitMQ --> wi
RabbitMQ --> wv
RabbitMQ --> ws_gateway
@enduml
