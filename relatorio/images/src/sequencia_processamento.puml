@startuml sequencia_processamento
!include estilo-vp.iuml
' Processamento de um vídeo por uma ferramenta de vídeo (o corte segue o mesmo fluxo, sem quota).

actor Utilizador
participant frontend
participant api_gateway
participant projects
participant users
queue RabbitMQ
participant "worker de vídeo" as W #FBE3CC
participant ws_gateway

Utilizador -> frontend : Aplicar
frontend -> api_gateway : processar projeto
api_gateway -> projects : processar projeto
projects -> users : reservar operação
projects --> api_gateway : em fila
api_gateway --> frontend : em fila
projects -> RabbitMQ : pedido por vídeo
RabbitMQ -> W : pedido

loop durante o processamento
  W -> RabbitMQ : progresso
  RabbitMQ -> projects : progresso
  projects -> RabbitMQ : progresso (ws_queue)
  RabbitMQ -> ws_gateway : progresso
  ws_gateway -> frontend : progresso
end

alt sucesso
  W -> RabbitMQ : resultado
  RabbitMQ -> projects : resultado
  projects -> projects : guardar resultado
else falha
  W -> RabbitMQ : erro
  RabbitMQ -> projects : erro
  projects -> users : devolver operação
end

projects -> RabbitMQ : vídeo terminado (ws_queue)
RabbitMQ -> ws_gateway : vídeo terminado
ws_gateway -> frontend : vídeo terminado
frontend -> api_gateway : pedir resultados
api_gateway -> projects : pedir resultados
projects --> api_gateway : ligações assinadas
api_gateway --> frontend : ligações assinadas
frontend -> Utilizador : mostrar resultado
@enduml
