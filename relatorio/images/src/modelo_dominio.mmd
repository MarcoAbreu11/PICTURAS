%% Modelo de domínio atualizado (Fase 1 — vídeo). Conceitos do problema, não classes de implementação.
classDiagram
  direction TB

  class Utilizador {
    <<abstract>>
  }
  class Anonimo["Anónimo"]
  class Registado
  class Premium
  Utilizador <|-- Anonimo
  Utilizador <|-- Registado
  Utilizador <|-- Premium

  class Limites["Limites de Vídeo do Perfil"] {
    tamanho máximo
    duração máxima
    resolução máxima de saída
  }
  class Quota["Quota Diária"] {
    operações disponíveis
  }
  Utilizador "*" --> "1" Limites : sujeito a
  Registado "1" --> "1" Quota : tem

  class Projeto
  Utilizador "1" --> "*" Projeto : é dono de
  Utilizador "*" --> "*" Projeto : acede por partilha (leitura | edição)

  class Item["Item de Média"] {
    <<abstract>>
    nome
    formato
    tamanho
  }
  class Imagem {
    resolução
  }
  class Video["Vídeo"] {
    duração
    resolução
    codec de vídeo
    codec de áudio
  }
  Item <|-- Imagem
  Item <|-- Video
  Projeto "1" *-- "*" Item : biblioteca
  Video "0..1" <-- "*" Video : convertido a partir de

  class Faixa["Faixa de Legendas"] {
    idioma: original ou inglês
    idioma detetado
  }
  Video "1" *-- "0..2" Faixa : tem

  class Ferramenta {
    <<abstract>>
    parâmetros
  }
  class Basica["Ferramenta Básica"]
  class Avancada["Ferramenta Avançada"] {
    consome 1 operação por item
  }
  Ferramenta <|-- Basica
  Ferramenta <|-- Avancada
  class TipoMedia["Tipo de Média"]
  note for TipoMedia "Imagem | Vídeo"
  Ferramenta "*" --> "1..2" TipoMedia : aceita

  class Corte["Cortar Vídeo"]
  class Frames["Extrair Frames"]
  class Desfocar["Desfocar Caras"]
  class Converter["Converter / Comprimir"]
  class Legendas["Gerar Legendas"]
  Basica <|-- Corte
  Avancada <|-- Frames
  Avancada <|-- Desfocar
  Avancada <|-- Converter
  Avancada <|-- Legendas

  Projeto "1" --> "*" Ferramenta : pipeline (ordenada)

  class Trabalho["Trabalho de Processamento"] {
    estado
    progresso em percentagem
    causa da falha
  }
  note for Trabalho "estado: em fila | em curso |<br/>concluído | falhado | cancelado"
  Projeto "1" --> "*" Trabalho : ao Aplicar, um por item compatível
  Trabalho "*" --> "1" Item : processa

  class Resultado
  class ResImg["Resultado Imagem"]
  class ResVid["Resultado Vídeo"]
  Resultado <|-- ResImg
  Resultado <|-- ResVid
  Trabalho "1" --> "0..*" Resultado : produz
  Trabalho "1" --> "0..1" Faixa : produz

  class Preset
  class Sugestao["Sugestão IA"]
  Utilizador "1" --> "*" Preset : cria
  Projeto "1" --> "*" Sugestao : recebe

  classDef novo fill:#FBE3CC,stroke:#C76C1B,color:#000000
  classDef alterado fill:#FFF4E5,stroke:#C76C1B,color:#000000
  classDef base fill:#EEEEEE,stroke:#9E9E9E,color:#616161
  cssClass "Item,Video,Limites,Faixa,TipoMedia,Corte,Frames,Desfocar,Converter,Legendas,Trabalho,ResVid" novo
  cssClass "Utilizador,Quota,Projeto,Imagem,Ferramenta,Avancada,Resultado,ResImg" alterado
  cssClass "Anonimo,Registado,Premium,Basica,Preset,Sugestao" base
